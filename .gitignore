.DS_Store
.antigravitycli/
*.log
.tao/
node_modules/
dist/
build/
.env
.env.*
!.env.example
# VibeGuard local secrets
!.env.sample
!.env.template
!.env.dist
!.env.defaults
!.env.schema
!.env*.default
!.env*.defaults
!.env*.dist
!.env*.example
!.env*.sample
!.env*.schema
!.env*.template
.env.vibeguard.local
# VibeGuard local state
.vibeguard/

# Wikimap document-search index. Source docs and the pinned adapter stay tracked;
# the deterministic SQLite cache is rebuilt locally by workflow.py.
.wikimap/

# Graphify local cache/runtime state. Keep current curated graph outputs visible.
graphify-out/cache/
graphify-out/.graphify_*
graphify-out/**/.graphify_*
graphify-out/cost.json
graphify-out/**/cost.json
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# The generated graph moved to .agents/local/graphify-out, and the rules above
# are anchored to the repository root, so they never covered the new location.
# `.agents/local` is local generated state by contract -- only `.agents/shared`
# is durable project knowledge -- so ignore the whole boundary.
.agents/local/

# tao-project-assets:start
# Runtime evidence is local, but canonical project skills are repository assets.
!.tao/
.tao/*
!.tao/.gitignore
!.tao/skills/
.tao/skills/*
!.tao/skills/graphify/
!.tao/skills/graphify/**
# tao-project-assets:end

# Evidence emitted from a nested working directory is always local runtime state.
*/.tao/

# Bytecode caches, written whenever the test suite or a hook runs.
__pycache__/
*.pyc

# figma-handoff local bundle workspace (never a tracked asset)
**/.figma-handoff-work/
